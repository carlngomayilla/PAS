# =============================================================================
# Template .env pour la PRODUCTION ANBG (PAS).
# A copier en `.env` sur le serveur (HORS GIT) puis remplir les valeurs reelles.
# `php artisan key:generate` doit etre execute apres la copie.
# =============================================================================

APP_NAME=PAS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Libreville
APP_URL=https://pas.anbg.ga
DASHBOARD_NEXT_PILOT_ENABLED=false
DASHBOARD_NEXT_PILOT_URL=/dashboard-pilot
DASHBOARD_NEXT_PILOT_HEALTH_URL=http://127.0.0.1:3000/dashboard-pilot/health

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# 12 rounds minimum en prod (le defaut Laravel est 12, garde-le).
BCRYPT_ROUNDS=12

# =============================================================================
# Logs : 14 jours rotatifs, niveau warning (pas debug ni info).
# Pour Sentry/Bugsnag ajouter un channel dedie dans config/logging.php.
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# =============================================================================
# Base de donnees : PostgreSQL sur la VM ANBG.
# Mot de passe a INJECTER au deploiement (vault / secret manager), pas ici.
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pas_anbg
DB_USERNAME=pas_user
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=3
DB_LOGIN_PREFLIGHT=true
DB_LOGIN_PREFLIGHT_TIMEOUT=1

# =============================================================================
# Sessions : HTTPS-only, chiffrees, SameSite strict.
# Driver `database` reposant sur la connection PG, pas `file`.
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PARTITIONED_COOKIE=false

# =============================================================================
# Politique mots de passe (niveau eleve).
# =============================================================================
SECURITY_PASSWORD_MIN_LENGTH=12
SECURITY_PASSWORD_EXPIRE_DAYS=90
SECURITY_PASSWORD_HISTORY_SIZE=5
SECURITY_PASSWORD_REQUIRE_LETTERS=true
SECURITY_PASSWORD_REQUIRE_MIXED_CASE=true
SECURITY_PASSWORD_REQUIRE_NUMBERS=true
SECURITY_PASSWORD_REQUIRE_SYMBOLS=true
SECURITY_PASSWORD_CHECK_PWNED=true

# Compte bootstrap administrateur fonctionnel cree par ProductionSafeSeeder.
# Ne pas commiter de mot de passe reel. Si INITIAL_PASSWORD reste vide,
# le seed genere un mot de passe temporaire et l'affiche une seule fois.
ADMIN_FONCTIONNEL_EMAIL=c.ngomayila.anbg@gmail.com
ADMIN_FONCTIONNEL_NAME="Administrateur fonctionnel"
ADMIN_FONCTIONNEL_INITIAL_PASSWORD=

# =============================================================================
# Justificatifs : chiffres au repos + antivirus actif (ClamAV installe sur la VM).
# fail_open=false pour bloquer l'upload si le scanner est indisponible.
# =============================================================================
SECURITY_ENCRYPT_JUSTIFICATIFS=true
ANTIVIRUS_SCAN_ENABLED=true
ANTIVIRUS_BINARY=clamscan
ANTIVIRUS_ARGUMENTS=--no-summary
ANTIVIRUS_TIMEOUT=30
ANTIVIRUS_FAIL_OPEN=false

# =============================================================================
# Broadcast / Queue / Cache / Filesystem.
# Redis et Horizon sont requis en production. Supervisor/systemd doit maintenir
# `php artisan horizon` actif pour les files ci-dessous.
# =============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
RETENTION_REPORTING_EXPORTS_DAYS=7
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=1500
REDIS_QUEUE_BLOCK_FOR=5

CACHE_STORE=redis_failover
CACHE_PREFIX=pas_anbg
CACHE_VERSION_STORE=database
CACHE_LIMITER_STORE=redis

# Connexion reservee : conserver SESSION_DRIVER=database tant que la revocation
# des sessions n est pas indexee independamment du stockage.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_HORIZON_DB=4

HORIZON_NAME=ANBG-PAS
HORIZON_PATH=horizon

# =============================================================================
# Mail SMTP : a configurer avec la passerelle officielle ANBG ou Brevo.
# MAIL_MAILER=log est interdit en production (alertes / digests perdus).
# =============================================================================
MAIL_MAILER=brevo
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@anbg.ga
MAIL_FROM_NAME="ANBG · e-Pilotage PAS"

# Canal email Brevo — transport API HTTP recommandé en production (pas de
# restriction IP). En cas de fallback SMTP, voir BREVO_USERNAME/PASSWORD.
BREVO_ENABLED=false                         # Activer seulement apres avoir renseigne et valide les credentials
BREVO_TRANSPORT=api
BREVO_API_KEY=                              # xkeysib-... — généré sur https://app.brevo.com/settings/keys/api
BREVO_API_ENDPOINT=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT=10
BREVO_API_VERIFY_SSL=true                   # ⚠️ TOUJOURS true en production

# Fallback SMTP (utilisé uniquement si BREVO_TRANSPORT=smtp)
BREVO_MAILER=brevo
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_SCHEME=smtp
BREVO_USERNAME=
BREVO_PASSWORD=

BREVO_FROM_ADDRESS=no-reply@anbg.ga
BREVO_FROM_NAME="ANBG · e-Pilotage PAS"

# Queue Brevo : connexion vide = connexion QUEUE_CONNECTION de l application.
BREVO_QUEUE_CONNECTION=
BREVO_QUEUE=notifications

# =============================================================================
# Sanctum : liste CSV des domaines stateful (front + back si SPA), expiration 8h.
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=pas.anbg.ga
SANCTUM_EXPIRATION=480

# =============================================================================
# Vite : ne pas inclure de secret ici (variables exposees au navigateur).
# =============================================================================
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Storage des parametres plateforme : base (table platform_settings).
# =============================================================================
PLATFORM_SETTINGS_DATABASE=true
