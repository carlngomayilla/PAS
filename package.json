{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "next:dev": "next dev frontend/dashboard-pilot --webpack",
        "next:build": "next build frontend/dashboard-pilot --webpack",
        "next:start": "next start frontend/dashboard-pilot",
        "next:typecheck": "tsc --project frontend/dashboard-pilot/tsconfig.json --noEmit",
        "next:test": "vitest run --config frontend/dashboard-pilot/vitest.config.ts",
        "test:ui": "vitest run tests/js --environment jsdom",
        "next:lint": "eslint --config frontend/dashboard-pilot/eslint.config.mjs frontend/dashboard-pilot/app frontend/dashboard-pilot/components frontend/dashboard-pilot/lib frontend/dashboard-pilot/tests frontend/dashboard-pilot/proxy.ts frontend/dashboard-pilot/next.config.ts frontend/dashboard-pilot/vitest.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:chromium": "playwright test --project=chromium",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "4.3.3",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.6",
        "@types/node": "24.13.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "axios": "^1.11.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.2",
        "jsdom": "29.1.1",
        "laravel-echo": "^2.3.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "8.5.26",
        "pusher-js": "^8.4.3",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "vite": "^7.0.7",
        "vitest": "4.1.11"
    },
    "dependencies": {
        "chart.js": "^4.5.1",
        "chartjs-chart-matrix": "^3.0.0",
        "chartjs-chart-treemap": "^3.1.0",
        "chartjs-plugin-annotation": "^3.1.0",
        "chartjs-plugin-datalabels": "^2.2.0",
        "d3": "^7.9.0",
        "gsap": "^3.13.0",
        "next": "16.3.2",
        "plotly.js-dist-min": "^3.6.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "swagger-ui-dist": "^5.32.0"
    }
}
